        <mxCell id="note" value="Important distinction: ROS bag playback simulates live vehicle data. In real vehicle tests, the bag reader is replaced by the actual vehicle data publisher; the MQTT subscriber/dashboard side stays the same." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1">
